# ╔══════════════════════════════════════╗
# ║   RADAR LOWCAP BOT — CONFIGURAÇÃO    ║
# ╚══════════════════════════════════════╝
# Copie para .env e preencha. NUNCA faça commit do .env.

# ── TELEGRAM ─────────────────────────────
TELEGRAM_BOT_TOKEN=
# Chat que recebe os alertas automáticos (ou use /setchat)
TELEGRAM_CHAT_ID=
# Opcional: ID do tópico em grupos com tópicos
TELEGRAM_THREAD_ID=
# IDs de usuário (separados por vírgula) autorizados a usar
# /radar, /set e /setchat. Descubra o seu com @userinfobot.
ADMIN_IDS=

# ── POLLING ──────────────────────────────
POLL_INTERVAL_MINUTES=30

# ── FILTROS ──────────────────────────────
MCAP_MIN=10000000
MCAP_MAX=100000000
MIN_VOL_24H=500000

# ── SCANNER ──────────────────────────────
SCORE_MINIMO=5
TOP_N_MOEDAS=10
TIMEFRAME_PADRAO=4h
